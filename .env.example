# LLM provider configuration
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 for deterministic local embeddings (offline/quota testing only)
# USE_LOCAL_EMBEDDINGS=0

# Tool safety limits
FILE_ASSISTANT_BASE_DIR=/path/to/project
FILE_ASSISTANT_MAX_BYTES=5000000
FILE_ASSISTANT_MAX_CHARS=200000
LLM_TOOL_MAX_CALLS=6
